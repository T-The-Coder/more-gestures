#!/usr/bin/env python3
"""More Gestures: evdev/uinput-Rahmen um die Entscheidungslogik in lib/gesture_core.py.

Greift Zeigegeräte exklusiv, reicht alles über ein eigenes uinput-Gerät 1:1 weiter und
hält nur die Auslösetaste zurück. JSON-Zeilen für den Dienst gehen nach stdout.
Mit --dry-run wird nichts gegriffen und nichts weitergereicht.
Befehle des Dienstes über stdin: `pass on|off` und `config {json}`.
"""

import argparse
import errno
import json
import os
import selectors
import signal
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import evdev  # noqa: E402
from evdev import ecodes  # noqa: E402

import gesture_core as core  # noqa: E402
import touchpad_core as tpc  # noqa: E402

RESCAN_INTERVAL = 2.0  # Sekunden zwischen den Hotplug-Abgleichen von /dev/input


class Stop(Exception):
    """Wird aus dem Signalhandler geworfen, damit select() sofort abbricht."""


def log(msg):
    print(msg, file=sys.stderr, flush=True)


class Pointer:
    def __init__(self, dev, engine, uinput):
        self.dev = dev
        self.engine = engine
        self.uinput = uinput
        self.last_state = engine.state


def is_pointing_stick(dev):
    """INPUT_PROP_POINTING_STICK oder udevs ID_INPUT_POINTINGSTICK (hwdb setzt das auch
    für Geräte ohne das Property-Bit, z. B. die SYNA-„Mouse“-Schnittstelle)."""
    if ecodes.INPUT_PROP_POINTING_STICK in dev.input_props():
        return True
    try:
        rdev = os.stat(dev.path).st_rdev
        with open(f"/run/udev/data/c{os.major(rdev)}:{os.minor(rdev)}") as f:
            return "E:ID_INPUT_POINTINGSTICK=1" in f.read().split("\n")
    except OSError:
        return False


class Daemon:
    def __init__(self, args):
        self.dry_run = args.dry_run
        self.config = core.Config(
            trigger=core.TRIGGER_BUTTONS[args.button],
            threshold=args.threshold,
            hold_time=args.hold_ms / 1000.0,
            emergency_time=args.emergency_s,
            rocker=args.rocker,
        )
        self.include_sticks = args.include_pointing_sticks
        self.passthrough = False  # `pass on` gilt auch für später angesteckte Geräte
        self.stdin_buf = b""
        self.sel = selectors.DefaultSelector()
        self.pointers = {}  # Pfad -> Pointer
        self.keyboards = {}  # Pfad -> (Gerät, gedrückte Modifier-Codes)
        # Touchpads are only read, never grabbed: libinput and Hyprland keep everything.
        self.touchpads = {}  # Pfad -> (Gerät, TouchpadEngine)
        self.tp_settings = tpc.TouchpadSettings(enabled=not args.no_touchpad)
        self.rejected = set()  # Pfade ohne passendes Gerät, nicht jede 2 s neu öffnen
        self.next_scan = 0.0

    # --- Ausgabe ------------------------------------------------------------

    def say(self, text):
        """Dry-run-Protokoll: nur Geräte und Zustandswechsel."""
        if self.dry_run:
            print(f"[dry-run] {text}", flush=True)

    def send(self, payload):
        print(json.dumps(payload, separators=(",", ":")), flush=True)

    # --- Geräte -------------------------------------------------------------

    def scan(self):
        paths = set(evdev.list_devices())
        self.rejected &= paths
        for path in set(self.pointers) - paths:
            self.drop_pointer(path)
        for path in set(self.keyboards) - paths:
            self.drop_keyboard(path)
        for path in set(self.touchpads) - paths:
            self.drop_touchpad(path)
        known = set(self.pointers) | set(self.keyboards) | set(self.touchpads)
        for path in sorted(paths - known - self.rejected):
            self.add_device(path)

    def add_device(self, path):
        try:
            dev = evdev.InputDevice(path)
        except OSError as e:
            # Gerät noch nicht bereit (Berechtigung der udev-Regel kommt verzögert):
            # nicht merken, der nächste Abgleich versucht es erneut.
            log(f"cannot open {path}: {e}")
            return
        caps = dev.capabilities()
        if tpc.classify_touchpad(caps, dev.input_props()):
            self.add_touchpad(path, dev)
            return
        kind = core.classify(dev.name, caps, self.config.trigger,
                             is_pointing_stick(dev), self.include_sticks)
        if kind == "pointer":
            self.add_pointer(path, dev)
        elif kind == "keyboard":
            self.keyboards[path] = (dev, set())
            self.sel.register(dev.fd, selectors.EVENT_READ, ("keyboard", path))
            self.say(f"keyboard (modifiers only): {dev.name} [{path}]")
        else:
            self.rejected.add(path)
            dev.close()

    def add_pointer(self, path, dev):
        uinput = None
        if not self.dry_run:
            try:
                # from_device copies only capabilities. Without the input props and
                # ids, libinput no longer sees a TrackPoint (props 0x21) as a pointing
                # stick: middle-button scrolling and its acceleration profile break,
                # and hwdb/quirk entries keyed on vendor/product stop matching.
                uinput = evdev.UInput.from_device(
                    dev, name=f"{core.VIRTUAL_NAME_PREFIX} ({dev.name})"[:79],
                    input_props=dev.input_props(),
                    vendor=dev.info.vendor, product=dev.info.product,
                    version=dev.info.version, bustype=dev.info.bustype,
                )
                dev.grab()
            except OSError as e:
                log(f"cannot grab {dev.name} [{path}]: {e}")
                if uinput:
                    uinput.close()
                dev.close()
                self.rejected.add(path)
                return
        engine = core.Engine(self.config)  # Config wird geteilt: `config {...}` wirkt überall
        engine.passthrough = self.passthrough
        self.pointers[path] = Pointer(dev, engine, uinput)
        self.sel.register(dev.fd, selectors.EVENT_READ, ("pointer", path))
        self.say(f"pointer: {dev.name} [{path}]")
        log(f"{'watching' if self.dry_run else 'grabbed'} {dev.name} [{path}]")

    def drop_pointer(self, path):
        p = self.pointers.pop(path)
        try:
            self.sel.unregister(p.dev.fd)
        except (KeyError, ValueError):
            pass
        self.close_pointer(p)
        self.say(f"pointer removed: [{path}]")
        self.update_modifiers(None)

    def close_pointer(self, p):
        try:
            if p.uinput:
                self.apply(p, p.engine.shutdown())
        except OSError:
            pass
        for step in (p.dev.ungrab if not self.dry_run else None, p.dev.close,
                     p.uinput.close if p.uinput else None):
            if step is None:
                continue
            try:
                step()
            except OSError:
                pass  # Gerät ist schon weg

    def add_touchpad(self, path, dev):
        def res(code):
            try:
                return dev.absinfo(code).resolution or 1
            except (OSError, KeyError):
                return 1
        engine = tpc.TouchpadEngine(self.tp_settings, res(tpc.ABS_MT_POSITION_X),
                                    res(tpc.ABS_MT_POSITION_Y))
        engine.set_passthrough(self.passthrough)
        self.touchpads[path] = (dev, engine)
        self.sel.register(dev.fd, selectors.EVENT_READ, ("touchpad", path))
        self.say(f"touchpad (read only): {dev.name} [{path}]")
        log(f"watching touchpad {dev.name} [{path}]")

    def drop_touchpad(self, path):
        dev, engine = self.touchpads.pop(path)
        try:
            self.sel.unregister(dev.fd)
        except (KeyError, ValueError):
            pass
        for m in engine.reset():
            self.send(m.payload)
        try:
            dev.close()
        except OSError:
            pass

    def read_touchpad(self, path):
        dev, engine = self.touchpads[path]
        for ev in dev.read():
            if ev.type == core.EV_SYN and ev.code == ecodes.SYN_DROPPED:
                for m in engine.reset():
                    self.send(m.payload)
                continue
            for m in engine.handle(time.monotonic(), ev.type, ev.code, ev.value):
                self.send(m.payload)

    def drop_keyboard(self, path):
        dev, _ = self.keyboards.pop(path)
        try:
            self.sel.unregister(dev.fd)
        except (KeyError, ValueError):
            pass
        dev.close()
        self.update_modifiers(time.monotonic())

    # --- Ereignisse ---------------------------------------------------------

    def apply(self, p, actions):
        for a in actions:
            if isinstance(a, core.Emit):
                if p.uinput:
                    p.uinput.write(a.etype, a.code, a.value)
            else:
                self.send(a.payload)
        if p.engine.state != p.last_state:
            self.say(f"{p.dev.name}: {p.last_state} -> {p.engine.state}")
            p.last_state = p.engine.state

    def read_pointer(self, path):
        p = self.pointers[path]
        for ev in p.dev.read():
            if ev.type == core.EV_SYN and ev.code == ecodes.SYN_DROPPED:
                p.engine.reset()  # Ereignisse verloren: Zustand nicht weiterschleppen
                continue
            if ev.type == core.EV_SYN and ev.code != ecodes.SYN_REPORT:
                continue
            self.apply(p, p.engine.handle(time.monotonic(), ev.type, ev.code, ev.value))

    def read_keyboard(self, path):
        dev, pressed = self.keyboards[path]
        for ev in dev.read():
            # Nur die vier Modifier-Familien; andere Tasten werden hier sofort
            # verworfen und weder gespeichert noch ausgegeben.
            if ev.type != core.EV_KEY or ev.code not in core.MODIFIER_CODES:
                continue
            if ev.value:
                pressed.add(ev.code)
            else:
                pressed.discard(ev.code)
        self.update_modifiers(time.monotonic())

    def update_modifiers(self, now):
        active = any(pressed for _, pressed in self.keyboards.values())
        for p in self.pointers.values():
            if p.engine.modifiers != active:
                self.apply(p, p.engine.set_modifiers(now or time.monotonic(), active))

    def read_stdin(self, fd):
        """Befehle des Dienstes lesen; False bei EOF (Dienst weg)."""
        data = os.read(fd, 4096)
        if not data:
            return False
        self.stdin_buf += data
        *lines, self.stdin_buf = self.stdin_buf.split(b"\n")
        self.stdin_buf = self.stdin_buf[-65536:]  # Zeile ohne Ende darf nicht unbegrenzt wachsen
        for line in lines:
            self.command(line.decode("utf-8", "replace"))
        return True

    def command(self, line):
        cmd = core.parse_command(line)
        if cmd is None:
            if line.strip():
                log(f"ignoring unknown command: {line.strip()[:80]}")
            return
        kind, value = cmd
        if kind == "pass":
            self.passthrough = value
            now = time.monotonic()
            for p in self.pointers.values():
                self.apply(p, p.engine.set_passthrough(now, value))
            for _, engine in self.touchpads.values():
                for m in engine.set_passthrough(value):
                    self.send(m.payload)
            self.say(f"pass {'on' if value else 'off'}")
        else:
            value = dict(value)
            touchpad = value.pop("touchpad", None)
            if isinstance(touchpad, dict):
                bad = tpc.update_settings(self.tp_settings, touchpad)
                if bad:
                    log(f"config: ignored invalid touchpad entries: {', '.join(map(str, bad))}")
            rejected = core.update_config(self.config, value)
            if rejected:
                log(f"config: ignored invalid entries: {', '.join(map(str, rejected))}")
            self.say(f"config: {self.config}")

    # --- Hauptschleife ------------------------------------------------------

    def run(self):
        stdin_fd = sys.stdin.fileno()
        self.sel.register(stdin_fd, selectors.EVENT_READ, ("stdin", None))
        self.say("start (nothing is grabbed)" if self.dry_run else "start")
        while True:
            now = time.monotonic()
            if now >= self.next_scan:
                self.scan()
                self.next_scan = now + RESCAN_INTERVAL
            for p in self.pointers.values():
                self.apply(p, p.engine.tick(now))
            deadlines = [self.next_scan] + [
                d for p in self.pointers.values() if (d := p.engine.deadline()) is not None
            ]
            timeout = max(0.0, min(deadlines) - time.monotonic())
            for key, _ in self.sel.select(timeout):
                kind, path = key.data
                try:
                    if kind == "stdin":
                        if not self.read_stdin(stdin_fd):
                            return  # Dienst weg oder Pipe zu: sauber beenden
                    elif kind == "pointer":
                        self.read_pointer(path)
                    elif kind == "touchpad":
                        self.read_touchpad(path)
                    else:
                        self.read_keyboard(path)
                except OSError as e:
                    if e.errno != errno.ENODEV:
                        log(f"{kind} {path}: {e}")
                    # Gerät abgezogen: nächster Abgleich räumt auf
                    if kind == "pointer" and path in self.pointers:
                        self.drop_pointer(path)
                    elif kind == "keyboard" and path in self.keyboards:
                        self.drop_keyboard(path)
                    elif kind == "touchpad" and path in self.touchpads:
                        self.drop_touchpad(path)
                    self.rejected.discard(path)

    def close(self):
        for path in list(self.pointers):
            self.drop_pointer(path)
        for path in list(self.keyboards):
            self.drop_keyboard(path)
        for path in list(self.touchpads):
            self.drop_touchpad(path)


def parse_args(argv):
    ap = argparse.ArgumentParser(description="More Gestures daemon")
    ap.add_argument("--dry-run", action="store_true",
                    help="grab nothing, forward nothing; print detected devices and state changes")
    ap.add_argument("--button", choices=sorted(core.TRIGGER_BUTTONS), default="right",
                    help="trigger button (default: right)")
    ap.add_argument("--threshold", type=float, default=core.Config.threshold,
                    help="movement threshold in raw units (default: %(default)s)")
    ap.add_argument("--hold-ms", type=float, default=core.Config.hold_time * 1000,
                    help="hold time before the press is replayed (default: %(default)s)")
    ap.add_argument("--emergency-s", type=float, default=core.Config.emergency_time,
                    help="reset a gesture held longer than this (default: %(default)s)")
    ap.add_argument("--rocker", action="store_true",
                    help="enable rocker gestures (trigger + left click and vice versa)")
    ap.add_argument("--no-touchpad", action="store_true",
                    help="do not read touchpads (3/4-finger gestures off)")
    ap.add_argument("--include-pointing-sticks", action="store_true",
                    help="also grab pointing sticks such as a TrackPoint (off by default)")
    return ap.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    daemon = Daemon(args)

    def stop(signum, frame):
        raise Stop

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        daemon.run()
    except Stop:
        pass
    finally:
        # Ein zweites Signal darf das Aufräumen nicht unterbrechen, sonst bliebe
        # die Maus gegriffen, bis der Prozess endet.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        daemon.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
