#!/bin/bash
# Writes the More Gestures app icon in the colors of the current Omarchy theme:
# a schematic mouse, i.e. a square split by a fine cross whose lower arm is missing
# (an upside-down T: two buttons on top, the body below). The right button, the
# gesture trigger, is filled with the theme's accent, like the sun in More Weather.
# Called by bin/install-app-entry and by the theme-set hook it installs.

set -u

colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
icon_dir="$HOME/.local/share/icons/hicolor/scalable/apps"
icon="$icon_dir/more-gestures.svg"

color() {
  local value
  value=$(grep -m1 -E "^[[:space:]]*$1[[:space:]]*=" "$colors" 2>/dev/null |
    sed -E 's/^[^=]*=[[:space:]]*"?(#[0-9A-Fa-f]{6,8})"?.*/\1/')
  [[ $value =~ ^#[0-9A-Fa-f]{6,8}$ ]] && echo "$value" || echo "$2"
}

tile=$(color background "#1a1b26")
edge=$(color lighter_background "#2a2b3d")
ink=$(color foreground "#c0caf5")
mark=$(color accent "#7aa2f7")

svg() {
  cat <<SVG
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128">
  <rect x="4" y="4" width="120" height="120" rx="28" fill="$tile" stroke="$edge" stroke-width="3"/>
  <path d="M64 25 H90 Q103 25 103 38 V64 H64 Z" fill="$mark"/>
  <g fill="none" stroke="$ink" stroke-linecap="round">
    <rect x="25" y="25" width="78" height="78" rx="13" stroke-width="7"/>
    <path d="M25 64 H103 M64 25 V64" stroke-width="3"/>
  </g>
</svg>
SVG
}

# --stdout: print only (used for previews and tests), no install.
if [[ ${1:-} == --stdout ]]; then svg; exit 0; fi

mkdir -p "$icon_dir"
tmp=$(mktemp "$icon_dir/.more-gestures.XXXXXX")
svg >"$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$icon"

# The hicolor dir carries an icon cache; without a refresh GTK lookups may
# not find a newly added icon.
if command -v gtk-update-icon-cache >/dev/null; then
  gtk-update-icon-cache -q -f "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
fi
